const express = require('express');
const router = express.Router();
const documentController = require('../controllers/documentController');
const autenticarToken = require('../middlewares/authMiddleware');
const multer = require('multer');

// Configuração do Multer em memória RAM (Fase 1 e Requisito Técnico)
const upload = multer({ 
    storage: multer.memoryStorage(),
    limits: { fileSize: 10 * 1024 * 1024 } // Limite seguro de 10MB
});

// Rota POST /api/chat/documento protegida por JWT e Multer
router.post('/', autenticarToken, upload.single('documento'), documentController.processarDocumento);

module.exports = router;